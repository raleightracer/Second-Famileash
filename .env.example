# Stripe TEST keys, from Stripe Dashboard > Developers > API keys (in Test mode).
# Copy this file to .env and fill in both values. .env is never committed.

# Publishable key (pk_test_...). Safe in the browser; Vite builds it into the site.
VITE_STRIPE_PUBLISHABLE_KEY=

# Secret key (sk_test_...). Server only, used by api/create-payment-intent.js.
# Never add VITE_ to its name: Vite would put it in the public site.
STRIPE_SECRET_KEY=
